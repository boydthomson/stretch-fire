# Copy to secrets.yaml (it is git-ignored) and fill in your own values.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
# Generate with:  python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
fire_api_key: "paste-a-32-byte-base64-key-here"
fire_ota_password: "choose-a-long-random-password"
fire_ap_password: "fallback-hotspot-password"
